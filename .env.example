APP_ENV=development

# PostgreSQL connection (docker-compose.local.yml).
PG_USER=poli
PG_PASSWORD=poli
PG_DB=poli
PG_PORT=5432
PG_HOST=localhost

ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

SESSION_TTL_SECONDS=2592000

# Explicit opt-in for local HTTP only. Production must set this to false.
ALLOW_INSECURE_COOKIES=true

# Local SeaweedFS S3 endpoint and credentials; replace credentials outside local development.
S3_PORT=8333
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key
S3_PUBLIC_BUCKET=poli-public
S3_PRIVATE_BUCKET=poli-private
