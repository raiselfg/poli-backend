APP_ENV=development

# PostgreSQL connection (docker-compose.local.yml).
PG_USER=poli
PG_PASSWORD=poli
PG_DB=poli
PG_PORT=5432
PG_HOST=localhost

ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

SESSION_TTL_SECONDS=2592000

# Explicit opt-in for local HTTP only. Production must set this to false.
ALLOW_INSECURE_COOKIES=true
