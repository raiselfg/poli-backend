APP_ENV=development
IS_REGISTER_DISABLE=true

# PostgreSQL connection (docker-compose.local.yml).
PG_USER=poli
PG_PASSWORD=poli
PG_DB=poli
PG_PORT=5432
PG_HOST=localhost

ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

SESSION_TTL_SECONDS=2592000

# Explicit opt-in for local HTTP only. Production must set this to false.
ALLOW_INSECURE_COOKIES=true

# Optional. Use a dedicated BotFather token, then connect in the admin requests page.
TELEGRAM_BOT_TOKEN=
# Optional SOCKS5 or HTTP CONNECT proxy for Telegram API requests.
TELEGRAM_PROXY_URL=

# Local RustFS S3 endpoint and credentials (console at http://localhost:9001).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key
# Create both buckets in the RustFS console before starting the backend.
# With a storage admin key, run `python -m app.storage.configure` once to allow public catalog reads.
S3_PUBLIC_BUCKET=poli-public
S3_PRIVATE_BUCKET=poli-private
